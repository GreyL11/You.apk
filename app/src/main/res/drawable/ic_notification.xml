<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar icon, 24dp. Android renders these as a single-colour silhouette from the alpha
     channel, so this is white-on-transparent by necessity, not by choice. Replaces
     android.R.drawable.ic_dialog_info, which was a system placeholder — every coach notification was
     arriving wearing Android's own "i" bubble. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M4.5,17.5 L10,12.5 L13.5,14.5 L19,7.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
